# MySQL connection used by Prisma. Do not commit real credentials.
# Example: mysql://USER:PASSWORD@127.0.0.1:3306/hr_taskflow
DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/hr_taskflow"

# Shared secret for POST /api/admin/tokens. Leave empty to disable that route.
# The issued bot tokens are not this value; they are random and stored only as hashes.
ADMIN_TOKEN=""
